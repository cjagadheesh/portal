{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyLookups",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeSpotPriceHistory",
        "ec2:DescribeImages",
        "ec2:DescribeVolumes",
        "ec2:DescribeAvailabilityZones",
        "ssm:DescribeInstanceInformation",
        "ce:GetCostAndUsage",
        "pricing:GetProducts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchABox",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplate",
        "ec2:CreateFleet",
        "ec2:RunInstances"
      ],
      "Resource": [
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:*",
        "arn:aws:ec2:<REGION>::image/*"
      ]
    },
    {
      "Sid": "DeleteOnlyTheTemplatesPortalMade",
      "Effect": "Allow",
      "Action": "ec2:DeleteLaunchTemplate",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:launch-template/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/portal:managed": "true"
        }
      }
    },
    {
      "Sid": "TagOnlyAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:*/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateFleet",
            "CreateLaunchTemplate",
            "CreateVolume"
          ]
        }
      }
    },
    {
      "Sid": "RetagPortalResources",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:*/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/portal:managed": "true"
        }
      }
    },
    {
      "Sid": "TerminateOnlyPortalInstances",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/portal:managed": "true"
        }
      }
    },
    {
      "Sid": "HomeVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVolume",
        "ec2:AttachVolume"
      ],
      "Resource": [
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:volume/*",
        "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*"
      ]
    },
    {
      "Sid": "DeleteOnlyPortalVolumes",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/portal:managed": "true"
        }
      }
    },
    {
      "Sid": "GiveBoxesTheirRoleAndFindTheControlPlane",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/portal-box",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "RediscoverTheControlPlane",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:instance-profile/portal-box"
    },
    {
      "Sid": "LookUpPublicAmiAndRegionNames",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:<REGION>::parameter/aws/service/*"
    },
    {
      "Sid": "OpenSessionsOnPortalBoxesOnly",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/portal:managed": "true"
        }
      }
    },
    {
      "Sid": "UseThePortForwardAndCommandDocuments",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": [
        "arn:aws:ssm:<REGION>::document/AWS-StartInteractiveCommand",
        "arn:aws:ssm:<REGION>::document/AWS-StartPortForwardingSession"
      ]
    },
    {
      "Sid": "EndOrResumeYourOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:*:*:session/*"
    }
  ]
}
