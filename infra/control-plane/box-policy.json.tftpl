{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MarkHomeVolumeResumable",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:${partition}:ec2:${region}:${account_id}:volume/*",
      "Condition": {
        "StringEquals": { "aws:ResourceTag/portal:managed": "true" },
        "ForAllValues:StringEquals": { "aws:TagKeys": ["portal:resumable"] }
      }
    }
  ]
}
